# Copy to .env. The CLI loads .env from the current directory without overriding
# variables that are already exported. Never commit the real file (.gitignore covers it).
#
# `ocular-evals models add <name> --url <base url> --key <secret>` appends the
# matching <VENDOR>_API_KEY line here for you; models.toml only ever holds the
# variable NAME, never a value.

# Hugging Face token. Optional for the public Converse-STT sample; needed only for
# private dataset repos or to avoid anonymous rate limits.
HF_TOKEN=

# OpenRouter: one key for every entry in models.toml marked "via OpenRouter"
# (https://openrouter.ai/settings/keys).
OPENROUTER_API_KEY=

# Direct vendor keys. Needed for the entries that call a vendor's own endpoint
# (OpenAI, Mistral) and for the native adapters (xai, meta, reson8, omi).
# Leave blank any vendor you do not use; `ocular-evals check` reports what is missing.
OPENAI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
META_API_KEY=
RESON8_API_KEY=
OMI_API_KEY=

# Not used by any current entry; the Deepgram Flux models would need it.
DEEPGRAM_API_KEY=
