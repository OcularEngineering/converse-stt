# Copy to .env. The CLI loads .env from the current directory without overriding
# variables that are already exported. Never commit the real file.
#
# `ocular-evals models add <name> --url <base url> --key <secret>` appends the
# matching <VENDOR>_API_KEY line here for you; models.toml only ever holds the
# variable NAME.

# Hugging Face token with read access to the Ocular AI dataset repos.
HF_TOKEN=

# Hosted providers. Only the ones you run need to be set.
OPENAI_API_KEY=
OMI_API_KEY=
